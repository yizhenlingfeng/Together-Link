{
    "schemaVersion": 1,
    "id": "bbs_together",
    "version": "${version}",
    "name": "Together Link",
    "description": "A BBS addon that adds multiplayer collaboration features: player color indicators, shared cursors, selection highlights, asset syncing, and synchronized recording.",
    "authors": [
        "McHorse",
        "ChillinWithDylan"
    ],
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "bbs-addon": [
            "mchorse.bbs_together.BBSTogether"
        ],
        "bbs-client-addon": [
            "mchorse.bbs_together.BBSTogetherClient"
        ],
        "main": [
            "mchorse.bbs_together.BBSTogetherMod"
        ],
        "client": [
            "mchorse.bbs_together.BBSTogetherModClient"
        ]
    },
    "mixins": [
        "bbs-together.mixins.json",
        {
            "config": "bbs-together.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.15.6",
        "minecraft": "~1.20.1",
        "java": ">=17",
        "fabric-api": "*",
        "bbs": ">=2.6"
    }
}
